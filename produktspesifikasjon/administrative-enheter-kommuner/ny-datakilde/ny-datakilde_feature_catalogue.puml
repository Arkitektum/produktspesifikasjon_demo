@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Administrative enheter kommuner - Ny datakilde - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class Kommune <<featureType>> {
    + identifikasjon_lokalid [1] : CharacterString
    + identifikasjon_navnerom [1] : CharacterString
    + identifikasjon_versjonid [0..1] : CharacterString
    + oppdateringsdato [1] : Date
    + gyldigfra [0..1] : Date
    + gyldigtil [0..1] : Date
    + datafangstdato [0..1] : Date
    + datauttaksdato [0..1] : Date
    + opphav [0..1] : CharacterString
    + kommunenummer [1] : CharacterString
    + kommunenavn [1] : CharacterString
    + samiskforvaltningsomraade [0..1] : Boolean
    + administrativenhetnavn [0..*] : administrativenhetnavn

    ..Geometri..
    + omraade [1] : GM_Surface
  }

  class Grense <<featureType>> {
    + identifikasjon_lokalid [1] : CharacterString
    + identifikasjon_navnerom [1] : CharacterString
    + identifikasjon_versjonid [0..1] : CharacterString
    + oppdateringsdato [1] : Date
    + gyldigfra [0..1] : Date
    + gyldigtil [0..1] : Date
    + datafangstdato [0..1] : Date
    + kvalitet_maalemetode [0..1] : CharacterString
    + kvalitet_noeyaktighet [0..1] : Integer
    + datauttaksdato [0..1] : Date
    + opphav [0..1] : CharacterString
    + avgrensningstype [1] : CharacterString

    ..Geometri..
    + grense [1] : GM_Curve
  }

  class Fylke <<featureType>> {
    + identifikasjon_lokalid [1] : CharacterString
    + identifikasjon_navnerom [1] : CharacterString
    + identifikasjon_versjonid [0..1] : CharacterString
    + oppdateringsdato [1] : Date
    + gyldigfra [0..1] : Date
    + gyldigtil [0..1] : Date
    + datafangstdato [0..1] : Date
    + datauttaksdato [0..1] : Date
    + opphav [0..1] : CharacterString
    + fylkesnummer [1] : CharacterString
    + fylkesnavn [1] : CharacterString
    + samiskforvaltningsomraade [0..1] : Boolean
    + administrativenhetnavn [0..*] : administrativenhetnavn

    ..Geometri..
    + omraade [1] : GM_Surface
  }

  class administrativenhetnavn <<dataType>> {
    + navn [1] : CharacterString
    + spraak [1] : CharacterString
    + rekkefoelge [0..1] : Integer
  }
}

  Kommune --> Grense : avgrensesavgrense [0..*]
  Fylke --> Grense : avgrensesavgrense [0..*]

@enduml
