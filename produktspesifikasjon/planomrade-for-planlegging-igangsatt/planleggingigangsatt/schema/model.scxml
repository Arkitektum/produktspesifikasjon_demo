    </sc:Class>
    <sc:Class>
     <sc:name>Planområde</sc:name>
     <sc:id>C2</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>featuretype</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>område for planlegging igangsatt etter pbl. 2008, med tilhørende metadata fra varsel om oppstart av planarbeid, slik det formidles i OGC API-Features fra Direktoratet for byggkvalitet.

Området skal være sammenhengende i grunnriss, men kan dekke flere vertikalnivåer.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>geometri</sc:name>
       <sc:id>C2_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>planområdets avgrensning i grunnriss. Området skal være sammenhengende i grunnriss, men kan dekke flere vertikalnivåer</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>GM_Surface</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>objid</sc:name>
       <sc:id>C2_2</sc:id>
