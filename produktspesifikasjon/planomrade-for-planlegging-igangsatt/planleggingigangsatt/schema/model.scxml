       <sc:name>navnerom</sc:name>
       <sc:id>C8_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>navnerom som unikt identifiserer datakilden til et objekt.

For plan anbefales navnerommet http://data.geonorge.no/sosi/plan</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>versjonId</sc:name>
       <sc:id>C8_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>identifikasjon av en spesiell versjon av et geografisk objekt (instans)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
