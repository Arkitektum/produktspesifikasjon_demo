     <sc:properties>
      <sc:Property>
       <sc:name>planid</sc:name>
       <sc:id>C3_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>entydig identifikasjon av en plan innen vedkommende administrative enhet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>kommunenummer</sc:name>
       <sc:id>C3_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode som viser til offisiell nummerering av kommuner, alltid 4 siffer med eventuell ledende null</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeId>C5</sc:typeId>
       <sc:typeName>Kommunenummer</sc:typeName>
      </sc:Property>
     </sc:properties>
