    <sc:Class>
     <sc:name>RpPlantype</sc:name>
     <sc:id>C12</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
