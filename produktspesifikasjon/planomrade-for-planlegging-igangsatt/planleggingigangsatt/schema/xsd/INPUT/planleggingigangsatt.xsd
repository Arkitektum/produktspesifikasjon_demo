  <element name="Planbehandling" substitutionGroup="gml:AbstractFeature" type="planleggingigangsatt:PlanbehandlingType">
    <annotation>
      <documentation>tidfestet behandling av en arealplan, både fram til planen trer i kraft, og etterpå</documentation>
    </annotation>
  </element>
  <complexType name="PlanbehandlingType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element name="planbehandlingsdato" type="date">
            <annotation>
              <documentation>dato for planbehandlingen (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element name="planbehandlingstype" type="gml:CodeType">
            <annotation>
              <documentation>type planbehandling, for eksempel planlegging igangsatt/oppstartsmøte avholdt (8) eller varsel om planoppstart (9) (forslag – må verifiseres)</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/plan/planregister/planbehandlingstype</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element name="navn" type="string">
            <annotation>
              <documentation>navn på eller kort beskrivelse av planbehandlingen (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="saksnummer" type="planleggingigangsatt:SaksnummerPropertyType">
            <annotation>
              <documentation>kommunens saksnummer for planbehandlingen (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element maxOccurs="unbounded" minOccurs="0" name="plandokument" type="planleggingigangsatt:PlandokumentPropertyType"/>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="PlanbehandlingPropertyType">
    <sequence minOccurs="0">
      <element ref="planleggingigangsatt:Planbehandling"/>
    </sequence>
