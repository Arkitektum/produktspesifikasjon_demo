    <attributeGroup ref="gml:OwnershipAttributeGroup"/>
  </complexType>
  <element name="Plandokument" substitutionGroup="gml:AbstractFeature" type="planleggingigangsatt:PlandokumentType">
    <annotation>
      <documentation>referanse til dokument som er knyttet til arealplanen (kart- og planforskriften § 9 første ledd). Et plandokument kan knyttes til den aktuelle planbehandlingen som det gjelder for.</documentation>
    </annotation>
  </element>
  <complexType name="PlandokumentType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element name="dokumenttype" type="gml:CodeType">
            <annotation>
              <documentation>type plandokument etter kodelisten Plandokumenttype i SOSI Planregister 5.0. For dokumenter ved varsel om oppstart brukes normalt KORR (planinitiativ, referat fra oppstartsmøte, varsel om oppstart, liste over varslede parter), KART (planavgrensning), PLANPROG (planprogram) og VEDTAK (vedtak om planoppstart), jf. KS/Geointegrasjon «Dokumenttyper for ePlansak»</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/plan/planregister/plandokumenttype</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="vedleggstype" type="planleggingigangsatt:VedleggstypeType">
            <annotation>
              <documentation>vedleggstype dokumentet ble innsendt med i Fellestjenester PLAN (planvarsel), f.eks. Planvarsel, PlanomraadeSosi, PlanomraadePdf, Planinitiativ, ReferatOppstartsmoete, Planprogram eller Annet. Gir finere inndeling enn dokumenttype (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="tittel" type="string">
            <annotation>
              <documentation>dokumentets tittel eller filnavn</documentation>
            </annotation>
          </element>
          <element name="referanseDokumentfil" type="string">
            <annotation>
              <documentation>lenke (URL) for nedlasting av dokumentfilen. Tilsvarer arkivreferanse i SOSI Planregister 5.0</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="dokumentdato" type="date">
            <annotation>
              <documentation>dokumentets egen dato (datert eller godkjent), ikke dato for innsending eller registrering</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="mimeType" type="string">
            <annotation>
              <documentation>filformat angitt som medietype (MIME-type) etter IANA, f.eks. application/pdf</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="sjekksum" type="string">
            <annotation>
              <documentation>sjekksum for dokumentfilen, brukt til å kontrollere at filen er uendret (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="sjekksumAlgoritme" type="string">
            <annotation>
              <documentation>algoritmen sjekksummen er beregnet med, f.eks. SHA-256 (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="beskrivelse" type="string">
            <annotation>
              <documentation>fritekst som beskriver dokumentets innhold</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="arkivnavn" type="string">
            <annotation>
              <documentation>navn på arkivet eller systemet der dokumentet er lagret</documentation>
            </annotation>
          </element>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="PlandokumentPropertyType">
    <sequence minOccurs="0">
      <element ref="planleggingigangsatt:Plandokument"/>
    </sequence>
    <attributeGroup ref="gml:AssociationAttributeGroup"/>
    <attributeGroup ref="gml:OwnershipAttributeGroup"/>
  </complexType>
