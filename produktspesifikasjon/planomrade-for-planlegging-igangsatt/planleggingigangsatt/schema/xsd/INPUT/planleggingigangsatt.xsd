<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:planleggingigangsatt="https://skjema.geonorge.no/SOSI/produktspesifikasjon/planomrade-for-planlegging-igangsatt/planleggingigangsatt/1.0" xmlns:sc="http://www.interactive-instruments.de/ShapeChange/AppInfo" elementFormDefault="qualified" targetNamespace="https://skjema.geonorge.no/SOSI/produktspesifikasjon/planomrade-for-planlegging-igangsatt/planleggingigangsatt/1.0" version="1.0">
  <import namespace="http://www.interactive-instruments.de/ShapeChange/AppInfo" schemaLocation="https://shapechange.net/resources/schema/ShapeChangeAppinfo.xsd"/>
  <import namespace="http://www.opengis.net/gml/3.2" schemaLocation="http://schemas.opengis.net/gml/3.2.1/gml.xsd"/>
  <!--XML Schema document created by ShapeChange - http://shapechange.net/-->
  <element name="Arealplan" substitutionGroup="gml:AbstractFeature" type="planleggingigangsatt:ArealplanType">
    <annotation>
      <documentation>dataobjekt for igangsatt planlegging etter plan- og bygningsloven, slik det formidles i OGC API-Features fra Direktoratet for byggkvalitet</documentation>
    </annotation>
  </element>
  <complexType name="ArealplanType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element minOccurs="0" name="objid" type="string">
            <annotation>
              <documentation>tjenestens interne identifikator for objektet (feature-id i OGC API)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="nasjonalArealplanId" type="planleggingigangsatt:NasjonalArealplanIdPropertyType">
            <annotation>
              <documentation>landsdekkende entydig og unik identifikasjon av en arealplan (pbl. §§ 6-4, 9-1 og 12-1, samt kart- og planforskriften § 9 andre og sjette ledd)

Denne identifikatoren tildeles planen når planprosessen starter, og den kan ikke endres undervegs av forslagstiller</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="identifikasjon" type="planleggingigangsatt:IdentifikasjonPropertyType">
            <annotation>
              <documentation>unik identifikasjon av et objekt i et datasett, forvaltet av den ansvarlige produsent/forvalter, og kan benyttes av eksterne applikasjoner som stabil referanse til objektet.

Merknad: Denne unike identifikatoren skal ikke endres i løpet av objektets levetid, og skal ikke gjenbrukes i andre objekt.</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="plannavn" type="string">
            <annotation>
              <documentation>planens offisielle navn</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="plantype" type="gml:CodeType">
            <annotation>
              <documentation>type reguleringsplan (pbl. §§ 12-2 og 12-3); angir om planen er en områderegulering eller detaljregulering</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/rpplantype</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="kunngjøringsdatoVarselOmPlanoppstart" type="date">
            <annotation>
              <documentation>dato da varsel om oppstart av planarbeid ble kunngjort og sendt til berørte parter som naboer, sektormyndigheter og lag/foreninger med interesser i planen (pbl. § 12-8)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="forslagsstillertype" type="string">
            <annotation>
              <documentation>om forslagsstiller er privat eller offentlig planmyndighet</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="lovreferanse" type="gml:CodeType">
            <annotation>
              <documentation>kode for hvilken lov planen vedtas etter. For planlegging igangsatt er lovreferanse = 6 (pbl. 2008)</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/lovreferanse</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="forsteDigitaliseringsdato" type="date">
            <annotation>
              <documentation>dato når en representasjon av objektet i digital form første gang ble etablert</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="oppdateringsdato" type="date">
            <annotation>
              <documentation>tidspunkt for siste endring på dataobjektet</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="link" type="string">
            <annotation>
              <documentation>lenke (URL) til nærmere informasjon om planen, for eksempel planinnsyn eller varselet om planoppstart</documentation>
            </annotation>
          </element>
          <element maxOccurs="unbounded" minOccurs="0" name="planleggingigangsatt" type="planleggingigangsatt:PlanområdePropertyType"/>
          <element maxOccurs="unbounded" minOccurs="0" name="plandokument" type="planleggingigangsatt:PlandokumentPropertyType"/>
          <element maxOccurs="unbounded" minOccurs="0" name="varslingsliste" type="planleggingigangsatt:BerørtPartPropertyType"/>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="ArealplanPropertyType">
    <sequence minOccurs="0">
      <element ref="planleggingigangsatt:Arealplan"/>
    </sequence>
    <attributeGroup ref="gml:AssociationAttributeGroup"/>
    <attributeGroup ref="gml:OwnershipAttributeGroup"/>
  </complexType>
  <element name="BerørtPart" substitutionGroup="gml:AbstractFeature" type="planleggingigangsatt:BerørtPartType">
    <annotation>
      <documentation>part som berøres av planarbeidet og skal varsles om oppstart av planarbeidet etter pbl. § 12-8, identifisert ved eiendom (matrikkelnummer) og/eller virksomhet (organisasjonsnummer) (forslag – må verifiseres)</documentation>
    </annotation>
  </element>
  <complexType name="BerørtPartType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element minOccurs="0" name="matrikkelnummer" type="planleggingigangsatt:MatrikkelnummerPropertyType">
            <annotation>
              <documentation>identifikasjon av eiendommen som parten er berørt gjennom (struktur etter SOSI Matrikkelen – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="organisasjonsnummer" type="string">
            <annotation>
              <documentation>organisasjonsnummer fra Enhetsregisteret (9 siffer) (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="BerørtPartPropertyType">
    <sequence minOccurs="0">
      <element ref="planleggingigangsatt:BerørtPart"/>
    </sequence>
    <attributeGroup ref="gml:AssociationAttributeGroup"/>
    <attributeGroup ref="gml:OwnershipAttributeGroup"/>
  </complexType>
  <element name="Identifikasjon" substitutionGroup="gml:AbstractObject" type="planleggingigangsatt:IdentifikasjonType"/>
  <complexType name="IdentifikasjonType">
    <sequence>
      <element minOccurs="0" name="lokalId" type="string">
        <annotation>
          <documentation>lokal identifikator av et objekt.

Skal være en uuid, slik at den er unik, uavhengig av navnerommet</documentation>
        </annotation>
      </element>
      <element minOccurs="0" name="navnerom" type="string">
        <annotation>
          <documentation>navnerom som unikt identifiserer datakilden til et objekt.

For plan anbefales navnerommet http://data.geonorge.no/sosi/plan</documentation>
        </annotation>
      </element>
      <element minOccurs="0" name="versjonId" type="string">
        <annotation>
          <documentation>identifikasjon av en spesiell versjon av et geografisk objekt (instans)</documentation>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <complexType name="IdentifikasjonPropertyType">
    <sequence>
      <element ref="planleggingigangsatt:Identifikasjon"/>
    </sequence>
  </complexType>
  <element name="Matrikkelnummer" substitutionGroup="gml:AbstractObject" type="planleggingigangsatt:MatrikkelnummerType"/>
  <complexType name="MatrikkelnummerType">
    <sequence>
      <element name="kommunenummer" type="gml:CodeType">
        <annotation>
          <documentation>kode som viser til offisiell nummerering av kommuner, alltid 4 siffer med eventuell ledende null</documentation>
          <appinfo>
            <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/inndelinger/inndelingsbase/kommunenummer</sc:targetCodeListURI>
          </appinfo>
        </annotation>
      </element>
      <element name="gårdsnummer" type="integer">
        <annotation>
          <documentation>gårdsnummer i matrikkelen (forslag – må verifiseres)</documentation>
        </annotation>
      </element>
      <element name="bruksnummer" type="integer">
        <annotation>
          <documentation>bruksnummer i matrikkelen (forslag – må verifiseres)</documentation>
        </annotation>
      </element>
      <element minOccurs="0" name="festenummer" type="integer">
        <annotation>
          <documentation>festenummer i matrikkelen (forslag – må verifiseres)</documentation>
        </annotation>
      </element>
      <element minOccurs="0" name="seksjonsnummer" type="integer">
        <annotation>
          <documentation>seksjonsnummer i matrikkelen (forslag – må verifiseres)</documentation>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <complexType name="MatrikkelnummerPropertyType">
    <sequence>
      <element ref="planleggingigangsatt:Matrikkelnummer"/>
    </sequence>
  </complexType>
  <element name="NasjonalArealplanId" substitutionGroup="gml:AbstractObject" type="planleggingigangsatt:NasjonalArealplanIdType"/>
  <complexType name="NasjonalArealplanIdType">
    <sequence>
      <element minOccurs="0" name="planid" type="string">
        <annotation>
          <documentation>entydig identifikasjon av en plan innen vedkommende administrative enhet</documentation>
        </annotation>
      </element>
      <element minOccurs="0" name="kommunenummer" type="gml:CodeType">
        <annotation>
          <documentation>kode som viser til offisiell nummerering av kommuner, alltid 4 siffer med eventuell ledende null</documentation>
          <appinfo>
            <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/inndelinger/inndelingsbase/kommunenummer</sc:targetCodeListURI>
          </appinfo>
        </annotation>
      </element>
    </sequence>
  </complexType>
  <complexType name="NasjonalArealplanIdPropertyType">
    <sequence>
      <element ref="planleggingigangsatt:NasjonalArealplanId"/>
    </sequence>
  </complexType>
  <element name="Plandokument" substitutionGroup="gml:AbstractFeature" type="planleggingigangsatt:PlandokumentType">
    <annotation>
      <documentation>referanse til dokument som er knyttet til arealplanen (kart- og planforskriften § 9 første ledd). Et plandokument kan knyttes til den aktuelle planbehandlingen som det gjelder for.</documentation>
    </annotation>
  </element>
  <complexType name="PlandokumentType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element name="dokumenttype" type="gml:CodeType">
            <annotation>
              <documentation>type plandokument, for eksempel planbeskrivelse, plankart eller varsel om oppstart (forslag – må verifiseres)</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/plan/planregister/plandokumenttype</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element name="arkivreferanse" type="string">
            <annotation>
              <documentation>referanse (URI eller arkivnøkkel) til dokumentet i arkivsystem eller dokumentlager (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="dokumentdato" type="date">
            <annotation>
              <documentation>dato da dokumentet ble datert eller godkjent (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="beskrivelse" type="string">
            <annotation>
              <documentation>fritekst som beskriver dokumentets innhold (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="arkivnavn" type="string">
            <annotation>
              <documentation>navn på arkivet eller systemet der dokumentet er lagret (forslag – må verifiseres)</documentation>
            </annotation>
          </element>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="PlandokumentPropertyType">
    <sequence minOccurs="0">
      <element ref="planleggingigangsatt:Plandokument"/>
    </sequence>
    <attributeGroup ref="gml:AssociationAttributeGroup"/>
    <attributeGroup ref="gml:OwnershipAttributeGroup"/>
  </complexType>
  <element name="Planområde" substitutionGroup="gml:AbstractFeature" type="planleggingigangsatt:PlanområdeType">
    <annotation>
      <documentation>område for planlegging igangsatt etter pbl. 2008, med tilhørende metadata fra varsel om oppstart av planarbeid, slik det formidles i OGC API-Features fra Direktoratet for byggkvalitet.

Området skal være sammenhengende i grunnriss, men kan dekke flere vertikalnivåer.</documentation>
    </annotation>
  </element>
  <complexType name="PlanområdeType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element name="geometri" type="gml:SurfacePropertyType">
            <annotation>
              <documentation>planområdets avgrensning i grunnriss. Området skal være sammenhengende i grunnriss, men kan dekke flere vertikalnivåer</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="objid" type="integer">
            <annotation>
              <documentation>tjenestens interne identifikator for objektet (feature-id i OGC API)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="identifikasjon" type="planleggingigangsatt:IdentifikasjonPropertyType">
            <annotation>
              <documentation>unik identifikasjon av et objekt i et datasett, forvaltet av den ansvarlige produsent/forvalter, og kan benyttes av eksterne applikasjoner som stabil referanse til objektet.

Merknad: Denne unike identifikatoren skal ikke endres i løpet av objektets levetid, og skal ikke gjenbrukes i andre objekt.</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="arealplan" type="integer">
            <annotation>
              <documentation>referanse (objid) til arealplanen planområdet tilhører</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="nasjonalArealplanId" type="planleggingigangsatt:NasjonalArealplanIdPropertyType">
            <annotation>
              <documentation>landsdekkende entydig og unik identifikasjon av en arealplan (pbl. §§ 6-4, 9-1 og 12-1, samt kart- og planforskriften § 9 andre og sjette ledd)

Denne identifikatoren tildeles planen når planprosessen starter, og den kan ikke endres undervegs av forslagstiller</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="plannavn" type="string">
            <annotation>
              <documentation>planens offisielle navn</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="plantype" type="gml:CodeType">
            <annotation>
              <documentation>type reguleringsplan (pbl. §§ 12-2 og 12-3); angir om planen er en områderegulering eller detaljregulering</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/rpplantype</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="kunngjøringsdatoVarselOmPlanoppstart" type="date">
            <annotation>
              <documentation>dato da varsel om oppstart av planarbeid ble kunngjort og sendt til berørte parter som naboer, sektormyndigheter og lag/foreninger med interesser i planen (pbl. § 12-8)</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="forslagsstillertype" type="string">
            <annotation>
              <documentation>om forslagsstiller er privat eller offentlig planmyndighet</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="lovreferanse" type="gml:CodeType">
            <annotation>
              <documentation>kode for hvilken lov planen vedtas etter. For planlegging igangsatt er lovreferanse = 6 (pbl. 2008)</documentation>
              <appinfo>
                <sc:targetCodeListURI>https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/lovreferanse</sc:targetCodeListURI>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="førsteDigitaliseringsdato" type="date">
            <annotation>
              <documentation>dato når en representasjon av objektet i digital form første gang ble etablert</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="oppdateringsdato" type="date">
            <annotation>
              <documentation>tidspunkt for siste endring på dataobjektet</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="link" type="string">
            <annotation>
              <documentation>lenke (URL) til nærmere informasjon om planen, for eksempel planinnsyn eller varselet om planoppstart</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="plan" type="planleggingigangsatt:ArealplanPropertyType"/>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="PlanområdePropertyType">
    <sequence minOccurs="0">
      <element ref="planleggingigangsatt:Planområde"/>
    </sequence>
    <attributeGroup ref="gml:AssociationAttributeGroup"/>
    <attributeGroup ref="gml:OwnershipAttributeGroup"/>
  </complexType>
</schema>
