@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Planområde for planlegging igangsatt - Planleggingigangsatt - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class Arealplan <<featureType>> {
    + objid [0..1] : CharacterString
    + nasjonalArealplanId [0..1] : NasjonalArealplanId
    + identifikasjon [0..1] : Identifikasjon
    + plannavn [0..1] : CharacterString
    + plantype [0..1] : RpPlantype
    + kunngjøringsdatoVarselOmPlanoppstart [0..1] : Date
    + forslagsstillertype [0..1] : CharacterString
    + lovreferanse [0..1] : Lovreferanse
    + forsteDigitaliseringsdato [0..1] : Date
    + oppdateringsdato [0..1] : Date
    + link [0..1] : CharacterString
  }

  class "Planområde" as Planomr_de <<featureType>> {
    + geometri [1] : GM_Surface
    + objid [0..1] : Integer
    + identifikasjon [0..1] : Identifikasjon
    + arealplan [0..1] : Integer
    + nasjonalArealplanId [0..1] : NasjonalArealplanId
    + plannavn [0..1] : CharacterString
    + plantype [0..1] : RpPlantype
    + kunngjøringsdatoVarselOmPlanoppstart [0..1] : Date
    + forslagsstillertype [0..1] : CharacterString
    + lovreferanse [0..1] : Lovreferanse
    + førsteDigitaliseringsdato [0..1] : Date
    + oppdateringsdato [0..1] : Date
    + link [0..1] : CharacterString
  }

  class "Varselområde" as Varselomr_de <<featureType>> {
    + geometri [1] : GM_Surface
    + objid [0..1] : Integer
    + identifikasjon [0..1] : Identifikasjon
    + arealplan [0..1] : Integer
  }

  class Plandokument <<featureType>> {
    + dokumenttype [1] : Plandokumenttype
    + vedleggstype [0..1] : Vedleggstype
    + tittel [0..1] : CharacterString
    + referanseDokumentfil [1] : CharacterString
    + dokumentdato [0..1] : Date
    + mimeType [0..1] : CharacterString
    + sjekksum [0..1] : CharacterString
    + sjekksumAlgoritme [0..1] : CharacterString
    + beskrivelse [0..1] : CharacterString
    + arkivnavn [0..1] : CharacterString
  }

  class "BerørtPart" as Ber_rtPart <<featureType>> {
    + matrikkelnummer [0..1] : Matrikkelnummer
    + organisasjonsnummer [0..1] : CharacterString
  }

  class Planbehandling <<featureType>> {
    + planbehandlingsdato [1] : Date
    + planbehandlingstype [1] : Planbehandlingstype
    + navn [1] : CharacterString
    + saksnummer [0..1] : Saksnummer
  }

  class NasjonalArealplanId <<dataType>> {
    + planid [0..1] : CharacterString
    + kommunenummer [0..1] : Kommunenummer
  }

  class Identifikasjon <<dataType>> {
    + lokalId [0..1] : CharacterString
    + navnerom [0..1] : CharacterString
    + versjonId [0..1] : CharacterString
  }

  class Matrikkelnummer <<dataType>> {
    + kommunenummer [1] : Kommunenummer
    + gårdsnummer [1] : Integer
    + bruksnummer [1] : Integer
    + festenummer [0..1] : Integer
    + seksjonsnummer [0..1] : Integer
  }

  class Saksnummer <<dataType>> {
    + saksår [1] : Integer
    + sakssekvensnummer [1] : Integer
  }
}

  Arealplan --> Planomr_de : planomrade [0..*]
  Arealplan --> Varselomr_de : varselomrade [0..*]
  Arealplan --> Plandokument : plandokument [0..*]
  Arealplan --> Ber_rtPart : varslingsliste [0..*]
  Arealplan --> Planbehandling : planbehandling [0..*]
  Planomr_de --> Arealplan : plan [0..1]
  Varselomr_de --> Arealplan : plan [0..1]
  Planbehandling --> Plandokument : plandokument [0..*]

@enduml
