      <sc:Value>datafangst.json</sc:Value>
     </sc:values>
    </sc:TaggedValue>
   </sc:taggedValues>
   <sc:classes>
    <sc:Class>
     <sc:name>Identifikasjon</sc:name>
     <sc:id>C4</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>lokalId</sc:name>
       <sc:id>C4_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>lokal identifikator av et objekt.

Skal være en uuid, slik at den er unik, uavhengig av navnerommet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>navnerom</sc:name>
       <sc:id>C4_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>navnerom som unikt identifiserer datakilden til et objekt.

Navnerom anbefales å være en http-URI og må være registrert i data.geonorge.no
For plan anbefales navnerommet http://data.geonorge.no/sosi/plan</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>versjonId</sc:name>
       <sc:id>C4_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>identifikasjon av en spesiell versjon av et geografisk objekt (instans)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>NasjonalArealplanId</sc:name>
     <sc:id>C5</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>kommunenummer</sc:name>
       <sc:id>C5_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode som viser til offisiell nummerering av kommuner

Merknad: Det presiseres at kommunenummer alltid skal ha 4 siffer, dvs. eventuelt med ledende null. Kommunenummer benyttes for kobling mot en rekke andre registre som også benytter 4 siffer.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeId>C6</sc:typeId>
       <sc:typeName>Kommunenummer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>landkode</sc:name>
       <sc:id>C5_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>landkode = NO anvendes kun av statlig vedtaksmyndighet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeId>C7</sc:typeId>
       <sc:typeName>Landkode</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>planid</sc:name>
       <sc:id>C5_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>entydig identifikasjon av en plan innen vedkommende administrative enhet (pbl. §§ 9-1, 12-1, samt kart- og planforskriften § 9 andre og sjette ledd)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>Kommunenummer</sc:name>
     <sc:id>C6</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>ekstern kodeliste for kommunenummer
Koder med status Gyldig refererer til dagens kommuner, mens koder med status Utgått referer til utgåtte kommunenummer</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>https://register.geonorge.no/sosi-kodelister/inndelinger/inndelingsbase/kommunenummer</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
    </sc:Class>
    <sc:Class>
     <sc:name>Landkode</sc:name>
     <sc:id>C7</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>enumeration</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>alfanumerisk kode for nasjonalt nivå / Norge.

Avledet fra "ISO 3166 Codes for the representation of names of countries and their subdivisions"</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>NO</sc:name>
       <sc:id>C7_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Norge. Aktuell kode for administrativ enhet for statlig vedtatte planer</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>RpPlantype</sc:name>
     <sc:id>C8</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>ekstern kodeliste for type reguleringsplan (pbl. §§ 12-2 og 12-3) ihht til gjeldende lov. Angir om planen er en områdeplan eller detaljplan.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/rpplantype</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
    </sc:Class>
    <sc:Class>
     <sc:name>Lovreferanse</sc:name>
     <sc:id>C9</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>ekstern kodeliste for gjeldende pbl.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/lovreferanse</sc:Value>
       </sc:values>
      </sc:TaggedValue>
      <sc:TaggedValue>
       <sc:name>asDictionary</sc:name>
       <sc:values>
        <sc:Value>true</sc:Value>
       </sc:values>
      </sc:TaggedValue>
     </sc:taggedValues>
    </sc:Class>
   </sc:classes>
   <sc:packages>
    <sc:Package>
     <sc:name>Fellesegenskaper</sc:name>
     <sc:id>P2</sc:id>
     <sc:classes>
      <sc:Class>
       <sc:name>Fellesegenskaper</sc:name>
       <sc:id>C1</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>abstrakt objekttype som bærer de egenskapene fra SOSI_Fellesegenskaper som er anvendt på objekttypene i denne modellen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:isAbstract>true</sc:isAbstract>
       <sc:properties>
        <sc:Property>
         <sc:name>identifikasjon</sc:name>
         <sc:id>C1_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>unik identifikasjon av et dataobjekt

Følger dataobjektet og identifiserer det i hele dets levetid.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C4</sc:typeId>
         <sc:typeName>Identifikasjon</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>oppdateringsdato</sc:name>
         <sc:id>C1_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>tidspunkt for siste endring på dataobjektet</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeName>Date</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
     </sc:classes>
    </sc:Package>
    <sc:Package>
     <sc:name>Planområde</sc:name>
     <sc:id>P3</sc:id>
     <sc:classes>
      <sc:Class>
       <sc:name>Arealplan</sc:name>
       <sc:id>C2</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>dataobjekt for igangsatt planlegging etter pbl</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C1</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>nasjonalArealplanId</sc:name>
         <sc:id>C2_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>landsdekkende entydig og unik identifikasjon av en arealplan (pbl. §§ 6-4, 9-1, og 12-1, samt kart- og planforskriften § 9 andre og sjette ledd).

Denne identifikatoren tildeles planen når planprosessen starter, og den kan ikke endres undervegs av forslagstiller.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C5</sc:typeId>
         <sc:typeName>NasjonalArealplanId</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>plantype</sc:name>
         <sc:id>C2_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>type reguleringsplan (pbl. §§ 12-2 og 12-3)</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C8</sc:typeId>
         <sc:typeName>RpPlantype</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>plannavn</sc:name>
         <sc:id>C2_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>planens offisielle navn</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>lovreferanse</sc:name>
         <sc:id>C2_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>kode for hvilken lov planen vedtas etter

For reguleringsplanforslag og planlegging igangsatt skal lovreferanse = 6 (pbl 2008)</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeId>C9</sc:typeId>
         <sc:typeName>Lovreferanse</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>planleggingIgangsatt</sc:name>
         <sc:id>Sas1</sc:id>
         <sc:cardinality>1..*</sc:cardinality>
         <sc:isNavigable>true</sc:isNavigable>
         <sc:sequenceNumber>5</sc:sequenceNumber>
         <sc:typeId>C3</sc:typeId>
         <sc:typeName>Planområde</sc:typeName>
         <sc:isAttribute>false</sc:isAttribute>
         <sc:associationId>as1</sc:associationId>
        </sc:Property>
       </sc:properties>
      </sc:Class>
      <sc:Class>
       <sc:name>Planområde</sc:name>
       <sc:id>C3</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>område for planlegging igangsatt etter pbl 2008.

Området skal være sammenhengende i grunnriss, men kan dekke flere vertikalnivåer</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C1</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>område</sc:name>
         <sc:id>C3_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>planens utstrekning i grunnriss uavhengig av vertikalnivå</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>GM_Surface</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
     </sc:classes>
    </sc:Package>
   </sc:packages>
  </sc:Package>
 </sc:packages>
