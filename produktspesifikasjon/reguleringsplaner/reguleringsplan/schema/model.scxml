    <sc:Package>
     <sc:name>Abstrakte typer</sc:name>
     <sc:id>P2</sc:id>
     <sc:classes>
      <sc:Class>
       <sc:name>RpAvgrensingslinje</sc:name>
       <sc:id>C6</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>abstrakt objekttype for avgrensingslinjer i en reguleringsplan

Brukes der det er behov for å ta vare på kvalitesinformasjon som ikke kan ligge på flateobjektene</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:isAbstract>true</sc:isAbstract>
       <sc:supertypes>
        <sc:SupertypeId>C1</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>nasjonalArealplanId</sc:name>
         <sc:id>C6_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>identifikasjon av arealplanen som objektet tilhører.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C39</sc:typeId>
         <sc:typeName>NasjonalArealplanId</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>vertikalnivå</sc:name>
         <sc:id>C6_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>beliggenhet i forhold til jordoverflaten
(kart- og planforskriften § 9 - https://lovdata.no/forskrift/2025-01-20-52/§9)</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>VERTNIV</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C47</sc:typeId>
         <sc:typeName>Vertikalnivå</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>vertikallag</sc:name>
         <sc:id>C6_3</sc:id>
