          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>identifikasjon og plassering av lag innen et vertikalnivå
(kart- og planforskriften § 9 - https://lovdata.no/forskrift/2025-01-20-52/§9)</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeId>C38</sc:typeId>
         <sc:typeName>Vertikallag</sc:typeName>
        </sc:Property>
