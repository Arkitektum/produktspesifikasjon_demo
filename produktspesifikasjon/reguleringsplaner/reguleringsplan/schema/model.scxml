      </sc:Property>
      <sc:Property>
       <sc:name>terrengreferanse</sc:name>
       <sc:id>C44_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>type terrengoverflate som danner utgangspunktet for å fastsette regulert høyde over terreng

Kan bare brukes for gesimshøyde og mønehøyde</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
